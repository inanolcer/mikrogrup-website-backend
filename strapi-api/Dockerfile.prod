# Creating multi-stage build for production
FROM node:24-alpine as build
RUN apk update && apk add --no-cache build-base gcc autoconf automake zlib-dev libpng-dev vips-dev git > /dev/null 2>&1
ARG NODE_ENV=production
ARG STRAPI_ADMIN_BACKEND_URL
ENV NODE_ENV=${NODE_ENV}
ENV STRAPI_ADMIN_BACKEND_URL=${STRAPI_ADMIN_BACKEND_URL}

WORKDIR /srv/app
COPY /strapi-api/package.json ./
RUN yarn global add node-gyp
RUN yarn config set network-timeout 1200000 -g && yarn install
ENV PATH /srv/app/node_modules/.bin:$PATH
COPY /strapi-api/ ./

# Ensure proper permissions for production
RUN mkdir -p /srv/app/node_modules/.strapi/vite && \
    mkdir -p /srv/.strapi && \
    mkdir -p /srv/build && \
    chown -R node:node /srv/app && \
    chown -R node:node /srv/.strapi && \
    chown -R node:node /srv/build

USER node
RUN yarn build --debug

# Creating final image
FROM node:24-alpine
RUN apk add --no-cache vips-dev
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

# Set database-related environment variables with safe defaults
ENV DATABASE_CLIENT=postgres
ENV DATABASE_SSL=false
ENV DATABASE_POOL_MIN=0
ENV DATABASE_POOL_MAX=10
ENV DATABASE_CONNECTION_TIMEOUT=60000

WORKDIR /srv/app
COPY --from=build /srv/app/node_modules ./node_modules
COPY --from=build /srv/app ./
ENV PATH /srv/app/node_modules/.bin:$PATH

EXPOSE 1337

# Healthcheck uses Node (wget is not installed in alpine) and respects PORT
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||1337)+'/_health',(r)=>{process.exit(r.statusCode>=200&&r.statusCode<300?0:1)}).on('error',()=>process.exit(1))"

# Use a script to start Strapi with debug info
COPY /strapi-api/docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh
ENTRYPOINT ["docker-entrypoint.sh"]

CMD ["yarn", "start"]
