{
  "kind": "collectionType",
  "collectionName": "redirects",
  "info": {
    "singularName": "redirect",
    "pluralName": "redirects",
    "displayName": "Redirect",
    "description": "URL redirect rules"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "domain": {
      "type": "enumeration",
      "enum": [
        "kozmoz.io",
        "samplr.io",
        "yonga.io"
      ]
    },
    "source": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "target": {
      "type": "string",
      "required": true
    },
    "regex": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "permanent",
      "enum": [
        "permanent",
        "temporary"
      ]
    },
    "from": {
      "type": "string",
      "required": true
    },
    "to": {
      "type": "string",
      "required": true
    },
    "statusCode": {
      "type": "integer",
      "default": 301
    }

  }
}
