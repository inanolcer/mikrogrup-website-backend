{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "links": {
      "type": "text"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "blocks.rich-text",
        "blocks.quote",
        "blocks.logos",
        "sections.section-title",
        "sections.hero-simple",
        "sections.call-to-action",
        "sections.features",
        "blocks.image",
        "blocks.card",
        "blocks.button"
      ]
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "products"
    }
  }
}
